# Application Configuration
PROJECT_NAME="Autonomous AI Testing and QA Agent"
ENVIRONMENT="development"
API_V1_STR="/api"

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# CORS Origins (JSON array or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Database Configuration
DATABASE_URL=
# DATABASE_URL="sqlite:///./autonomous_qa.db"
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/autonomous_qa"

# Playwright & Crawler Settings
PLAYWRIGHT_HEADLESS=true
MAX_CRAWL_PAGES=30
MAX_CRAWL_DEPTH=3
CRAWL_TIMEOUT_SECONDS=15

# Storage
ARTIFACTS_DIR="./artifacts"

# AI / LLM Configuration
AI_PROVIDER="gemini"
GEMINI_API_KEY=
GEMINI_MODEL="gemini-1.5-flash"
